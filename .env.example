# Copy to .env and fill in your own values. Never commit .env.
# The ETL package, the Airflow DAGs and the Makefile all read these names.

# Required: GCP project that owns the buckets and Dataproc resources.
GCP_PROJECT_ID=your-gcp-project-id

# Optional: defaults shown below.
GCP_REGION=europe-west3
CODE_BUCKET=data-lake-code-v2-your-project-number
RAW_BUCKET=my_data
DATA_BUCKET=my_data_lake_v2
PHS_BUCKET=spark-hist-repo-your-project-number
PHS_CLUSTER=spark-hist-srv-your-gcp-project-id
METASTORE_SERVICE=data-catalog-your-gcp-project-id

# Optional: path to a service-account key for local runs.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json
